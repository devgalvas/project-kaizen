// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. User
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Relacionamentos
  avatar       Avatar?
  tasks        Task[]
  notifications Notification[]
}

// 2. Avatar
model Avatar {
  id        String @id @default(uuid())
  level     Int    @default(1)
  currentXP Int    @default(0)
  coins     Int    @default(0)

  // Relacionamentos
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillTrees   SkillTree[]
  achievements Achievement[]
}

// 3. Task (Interface base para ITask)
model Task {
  id          String   @id @default(uuid())
  title       String
  description String
  xpReward    Int

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tipos Especializados (Polimorfismo / Herança em tabelas)
  habit       Habit?
  daily       Daily?
  mission     Mission?
}

// 4. Habit (Implementa ITask)
model Habit {
  id        String @id @default(uuid())
  streak    Int    @default(0)
  frequency String 
  
  taskId    String @unique
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// 5. Daily (Implementa ITask)
model Daily {
  id        String   @id @default(uuid())
  dueDate   DateTime
  isOverdue Boolean  @default(false)

  taskId    String @unique
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// 6. Mission (Adicionado para suportar os controllers existentes)
model Mission {
  id         String @id @default(uuid())
  coinReward Int
  isDaily    Boolean @default(false)
  
  taskId    String @unique
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// 7. SkillTree
model SkillTree {
  id       String @id @default(uuid())
  category String
  nodes    String[] 

  avatarId String
  avatar   Avatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)
}

// 8. RewardStore
model RewardStore {
  id             String @id @default(uuid())
  availableItems Item[]
}

// 9. Item
model Item {
  id            String @id @default(uuid())
  name          String
  price         Int
  rarity        String
  
  rewardStoreId String?
  rewardStore   RewardStore? @relation(fields: [rewardStoreId], references: [id], onDelete: Cascade)
}

// 10. Achievement
model Achievement {
  id         String @id @default(uuid())
  criteria   String
  isUnlocked Boolean @default(false)

  avatarId   String?
  avatar     Avatar? @relation(fields: [avatarId], references: [id], onDelete: Cascade)
}

// 11. Notification (Substitui NotificationService para guardar estado)
model Notification {
  id      String @id @default(uuid())
  message String

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
